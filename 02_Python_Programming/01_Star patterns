#Hallow square with + desing inside
n=5
for i in range(1,n+1):
    for j in range(1,n+1):
        if (i==1) or (i==n) or (j==n) or (j==1) :
            print("*",end=" ")
        elif (i==2) or (i==n-1) or (j==2) or (j==n-1):
            print("+",end=" ")
        else:
            print(" ",end=" ")
    print()

