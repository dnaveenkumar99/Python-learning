Star Patterns

1.Square pattern
n=int(input("Enter a number:"))
for i in range(1,n+1):
    for j in range(1,n+1):
        print("*",end=" ")
    print()

2.Triangle Patterns

n=5
for i in range(1,n+1):
    for j in range(1,i+1):
        print("*",end=" ")
    print()

n=5
for i in range(1,n+1):
    for j in range(1,n-i+2):
        print("*",end=" ")
    print()

n=5
for i in range(1,n+1):
    for j in range(1,n-i+1):
        print(" ",end=" ")
    for k in range(1,i+1):
        print("*",end=" ")
    print()

n=5
for i in range(1,n+1):
    for j in range(1,n-i+2):
        print("*",end=" ")
    for space in range(1,i):
        print(" ",end=" ")
    print()

